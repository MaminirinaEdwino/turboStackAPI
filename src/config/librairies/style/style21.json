{
    "desktop": {
        ".badge-accent": "background-color: rgba(212, 163, 115, 0.15); color: #d4a373; border: 1px solid #d4a373;",
        ".badge-pill": "display: inline-block; padding: 4px 12px; border-radius: 4px; font-size: 12px; font-weight: 700; margin-bottom: 20px;",
        ".bg-dark-surface": "background-color: #362621;",
        ".bg-gradient-dark": "background: linear-gradient(180deg, #362621 0%, #2b1e1a 100%);",
        ".bg-radial-glow": "background: radial-gradient(circle at 50% 20%, #422f29 0%, #2b1e1a 70%);",
        ".border-b-dark": "border-bottom: 1px solid #422f29;",
        ".border-t-dark": "border-top: 1px solid #422f29;",
        ".brand-logo": "font-weight: 700; font-size: 20px; color: #d4a373; font-family: serif;",
        ".btn-lg": "padding: 14px 28px; font-size: 18px;",
        ".btn-md": "padding: 10px 20px; font-size: 16px;",
        ".btn-primary": "background-color: #d4a373; color: #2b1e1a; border: none; font-weight: 700; cursor: pointer; border-radius: 4px;",
        ".btn-sm": "padding: 6px 12px; font-size: 14px;",
        ".card-bordered": "border: 1px solid #584138;",
        ".card-surface": "background-color: #362621; border-radius: 6px;",
        ".container-lg": "max-width: 1200px; margin: 0 auto;",
        ".container-md": "max-width: 800px; margin: 0 auto;",
        ".flex-between": "display: flex; justify-content: space-between; align-items: center;",
        ".flex-center": "display: flex; justify-content: center; align-items: center;",
        ".footer-container": "padding: 32px; background-color: #2b1e1a;",
        ".gap-lg": "gap: 48px;",
        ".gap-md": "gap: 24px;",
        ".gap-sm": "gap: 12px;",
        ".glow-effect": "box-shadow: 0 4px 15px rgba(212, 163, 115, 0.25);",
        ".grid-2-cols": "display: grid; grid-template-columns: repeat(2, 1fr);",
        ".grid-3-cols": "display: grid; grid-template-columns: repeat(3, 1fr);",
        ".heading-lg": "font-size: 32px; font-weight: 700; line-height: 1.2; font-family: serif;",
        ".heading-md": "font-size: 24px; font-weight: 600; font-family: serif;",
        ".heading-xl": "font-size: 48px; font-weight: 700; line-height: 1.15; margin-bottom: 16px; color: #fefae0; font-family: serif;",
        ".hero-section": "padding: 96px 24px; background: #2b1e1a;",
        ".input-field": "width: 100%; padding: 10px 16px; background-color: #2b1e1a; border: 1px solid #584138; border-radius: 4px; color: #faedcd; font-size: 15px;",
        ".items-center": "align-items: center;",
        ".max-w-sm": "max-width: 480px;",
        ".mb-md": "margin-bottom: 24px;",
        ".mb-xl": "margin-bottom: 48px;",
        ".mx-auto": "margin-left: auto; margin-right: auto;",
        ".navbar-sticky": "position: sticky; top: 0; display: flex; justify-content: space-between; align-items: center; padding: 16px 32px; background-color: #2b1e1a; z-index: 100;",
        ".p-lg": "padding: 32px;",
        ".section-spacing": "padding: 80px 24px;",
        ".text-accent": "color: #d4a373;",
        ".text-center": "text-align: center;",
        ".text-lead": "font-size: 18px; line-height: 1.6;",
        ".text-muted": "color: #ccd5ae;",
        ".text-primary": "color: #faedcd;",
        ".text-sm": "font-size: 14px;",
        ".text-subtle": "color: #584138;"
    },
    "mobile": {
        ".flex-between": "flex-direction: column; gap: 16px;",
        ".grid-2-cols": "grid-template-columns: 1fr;",
        ".grid-3-cols": "grid-template-columns: 1fr;",
        ".heading-xl": "font-size: 28px;"
    },
    "tablet": {
        ".grid-3-cols": "grid-template-columns: repeat(2, 1fr);",
        ".heading-xl": "font-size: 36px;"
    }
}