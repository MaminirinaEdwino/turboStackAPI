{
    "desktop": {
        ".bg-green": "background-color: #059669;",
        ".bg-green-light": "background-color: #dcfce7;",
        ".bg-white": "background-color: #ffffff;",
        ".border-t-subtle": "border-top: 1px solid #e5e7eb;",
        ".brand-logo": "font-weight: 800; font-size: 22px;",
        ".btn-green": "background-color: #059669; color: #ffffff; border: none; font-weight: 600; cursor: pointer; border-radius: 6px;",
        ".btn-lg": "padding: 14px 28px; font-size: 16px;",
        ".btn-sm": "padding: 8px 16px; font-size: 14px;",
        ".btn-white": "background-color: #ffffff; border: none; font-weight: 700; cursor: pointer; border-radius: 6px;",
        ".card-green-soft": "background-color: #f0fdf4; border: 1px solid #dcfce7; border-radius: 8px;",
        ".container-lg": "max-width: 1140px; margin: 0 auto;",
        ".container-md": "max-width: 720px; margin: 0 auto;",
        ".footer-container": "padding: 32px;",
        ".gap-lg": "gap: 40px;",
        ".gap-md": "gap: 24px;",
        ".grid-2-cols": "display: grid; grid-template-columns: 1fr 1fr;",
        ".grid-3-cols": "display: grid; grid-template-columns: repeat(3, 1fr);",
        ".heading-lg": "font-size: 32px; font-weight: 700;",
        ".heading-md": "font-size: 24px; font-weight: 700;",
        ".heading-xl": "font-size: 42px; font-weight: 800; line-height: 1.2;",
        ".hero-section": "padding: 70px 24px; background-color: #f0fdf4;",
        ".hero-text-block": "padding-right: 20px;",
        ".items-center": "align-items: center;",
        ".mb-lg": "margin-bottom: 32px;",
        ".media-placeholder": "height: 300px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-weight: 600;",
        ".mt-md": "margin-top: 24px;",
        ".mt-sm": "margin-top: 12px;",
        ".my-md": "margin-top: 20px; margin-bottom: 20px;",
        ".navbar-light": "display: flex; justify-content: space-between; align-items: center; padding: 18px 48px;",
        ".p-md": "padding: 24px;",
        ".section-spacing": "padding: 72px 24px;",
        ".shadow-sm": "box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);",
        ".shadow-xs": "box-shadow: 0 1px 2px rgba(0,0,0,0.05);",
        ".text-center": "text-align: center;",
        ".text-green": "color: #059669;",
        ".text-green-dark": "color: #064e3b;",
        ".text-lead": "font-size: 18px; line-height: 1.6;",
        ".text-muted": "color: #4b5563;",
        ".text-white": "color: #ffffff;"
    },
    "mobile": {
        ".grid-3-cols": "grid-template-columns: 1fr;",
        ".heading-xl": "font-size: 30px;"
    },
    "tablet": {
        ".grid-2-cols": "grid-template-columns: 1fr;",
        ".grid-3-cols": "grid-template-columns: repeat(2, 1fr);"
    }
}