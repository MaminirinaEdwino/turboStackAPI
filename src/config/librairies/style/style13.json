{
    "desktop": {
        ".badge-accent": "background-color: rgba(0, 240, 255, 0.1); color: #00f0ff; border: 1px solid #00f0ff;",
        ".badge-pill": "display: inline-block; padding: 4px 12px; border-radius: 2px; font-size: 12px; font-weight: 800; margin-bottom: 20px; text-transform: uppercase;",
        ".bg-dark-surface": "background-color: #0c0c14;",
        ".bg-gradient-dark": "background: linear-gradient(180deg, #0c0c14 0%, #05050a 100%);",
        ".bg-radial-glow": "background: radial-gradient(circle at 50% 20%, #ff007f33 0%, #05050a 70%);",
        ".border-b-dark": "border-bottom: 1px solid #ff007f;",
        ".border-t-dark": "border-top: 1px solid #ff007f;",
        ".brand-logo": "font-weight: 800; font-size: 20px; letter-spacing: 1px; color: #00f0ff; text-transform: uppercase;",
        ".btn-lg": "padding: 14px 28px; font-size: 18px;",
        ".btn-md": "padding: 10px 20px; font-size: 16px;",
        ".btn-primary": "background-color: #ff007f; color: #ffffff; border: none; font-weight: 800; cursor: pointer; border-radius: 2px; text-transform: uppercase;",
        ".btn-sm": "padding: 6px 12px; font-size: 14px;",
        ".card-bordered": "border: 1px solid #00f0ff44;",
        ".card-surface": "background-color: #0c0c14; border-radius: 4px;",
        ".container-lg": "max-width: 1200px; margin: 0 auto;",
        ".container-md": "max-width: 800px; margin: 0 auto;",
        ".flex-between": "display: flex; justify-content: space-between; align-items: center;",
        ".flex-center": "display: flex; justify-content: center; align-items: center;",
        ".footer-container": "padding: 32px; background-color: #05050a;",
        ".gap-lg": "gap: 48px;",
        ".gap-md": "gap: 24px;",
        ".gap-sm": "gap: 12px;",
        ".glow-effect": "box-shadow: 0 0 15px #ff007f, 0 0 30px #00f0ff;",
        ".grid-2-cols": "display: grid; grid-template-columns: repeat(2, 1fr);",
        ".grid-3-cols": "display: grid; grid-template-columns: repeat(3, 1fr);",
        ".heading-lg": "font-size: 32px; font-weight: 800; line-height: 1.2;",
        ".heading-md": "font-size: 24px; font-weight: 700;",
        ".heading-xl": "font-size: 48px; font-weight: 900; line-height: 1.15; margin-bottom: 16px; color: #ffffff; text-shadow: 0 0 10px #ff007f;",
        ".hero-section": "padding: 96px 24px; background: #05050a;",
        ".input-field": "width: 100%; padding: 10px 16px; background-color: #05050a; border: 1px solid #ff007f; border-radius: 2px; color: #00f0ff; font-size: 15px;",
        ".items-center": "align-items: center;",
        ".max-w-sm": "max-width: 480px;",
        ".mb-md": "margin-bottom: 24px;",
        ".mb-xl": "margin-bottom: 48px;",
        ".mx-auto": "margin-left: auto; margin-right: auto;",
        ".navbar-sticky": "position: sticky; top: 0; display: flex; justify-content: space-between; align-items: center; padding: 16px 32px; background-color: #05050a; z-index: 100;",
        ".p-lg": "padding: 32px;",
        ".section-spacing": "padding: 80px 24px;",
        ".text-accent": "color: #ff007f;",
        ".text-center": "text-align: center;",
        ".text-lead": "font-size: 18px; line-height: 1.6;",
        ".text-muted": "color: #8a8b9e;",
        ".text-primary": "color: #00f0ff;",
        ".text-sm": "font-size: 14px;",
        ".text-subtle": "color: #555670;"
    },
    "mobile": {
        ".flex-between": "flex-direction: column; gap: 16px;",
        ".grid-2-cols": "grid-template-columns: 1fr;",
        ".grid-3-cols": "grid-template-columns: 1fr;",
        ".heading-xl": "font-size: 28px;"
    },
    "tablet": {
        ".grid-3-cols": "grid-template-columns: repeat(2, 1fr);",
        ".heading-xl": "font-size: 36px;"
    }
}