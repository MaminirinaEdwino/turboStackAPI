{
    "desktop": {
        ".bg-dark-card": "background-color: #0f0a1c;",
        ".bg-gradient-purple": "background: linear-gradient(135deg, #6b21a8 0%, #3b0764 100%);",
        ".brand-logo": "font-weight: 900; font-size: 22px; letter-spacing: 1px;",
        ".btn-lg": "padding: 16px 36px; font-size: 18px;",
        ".btn-purple-pill": "background-color: #a855f7; color: #ffffff; border: none; font-weight: 700; border-radius: 9999px; cursor: pointer;",
        ".btn-sm": "padding: 8px 20px; font-size: 14px;",
        ".btn-white-pill": "background-color: #ffffff; color: #3b0764; border: none; font-weight: 800; border-radius: 9999px; cursor: pointer;",
        ".card-dark-rounded": "background-color: #160f29; border-radius: 16px; border: 1px solid #281a42;",
        ".container-lg": "max-width: 1140px; margin: 0 auto;",
        ".container-md": "max-width: 760px; margin: 0 auto;",
        ".container-sm": "max-width: 580px; margin: 0 auto;",
        ".footer-container": "padding: 32px; background-color: #090514;",
        ".gap-md": "gap: 24px;",
        ".grid-3-cols": "display: grid; grid-template-columns: repeat(3, 1fr);",
        ".heading-lg": "font-size: 36px; font-weight: 800;",
        ".heading-md": "font-size: 28px; font-weight: 700;",
        ".heading-xl": "font-size: 48px; font-weight: 900; line-height: 1.1;",
        ".hero-section": "padding: 90px 24px; background-color: #090514;",
        ".mb-lg": "margin-bottom: 32px;",
        ".mt-md": "margin-top: 24px;",
        ".mt-sm": "margin-top: 12px;",
        ".my-md": "margin-top: 20px; margin-bottom: 20px;",
        ".navbar-dark": "display: flex; justify-content: space-between; align-items: center; padding: 20px 40px; background-color: #090514;",
        ".p-md": "padding: 28px;",
        ".section-spacing": "padding: 80px 24px;",
        ".text-center": "text-align: center;",
        ".text-lead": "font-size: 18px;",
        ".text-muted": "color: #94a3b8;",
        ".text-purple": "color: #a855f7;",
        ".text-white": "color: #ffffff;"
    },
    "mobile": {
        ".grid-3-cols": "grid-template-columns: 1fr;",
        ".heading-xl": "font-size: 28px;"
    },
    "tablet": {
        ".grid-3-cols": "grid-template-columns: repeat(2, 1fr);",
        ".heading-xl": "font-size: 36px;"
    }
}