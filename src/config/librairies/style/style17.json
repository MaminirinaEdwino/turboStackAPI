{
    "desktop": {
        ".badge-accent": "color: #6d5dfc;",
        ".badge-pill": "display: inline-block; padding: 6px 16px; border-radius: 20px; font-size: 12px; font-weight: 700; margin-bottom: 20px; box-shadow: inset 2px 2px 5px #b8b9be, inset -3px -3px 7px #ffffff;",
        ".bg-dark-surface": "background-color: #e0e5ec;",
        ".bg-gradient-dark": "background: #e0e5ec;",
        ".bg-radial-glow": "background: radial-gradient(circle at 50% 20%, #e6ecf5 0%, #e0e5ec 70%);",
        ".border-b-dark": "border-bottom: 1px solid #d1d9e6;",
        ".border-t-dark": "border-top: 1px solid #d1d9e6;",
        ".brand-logo": "font-weight: 800; font-size: 20px; color: #31344b;",
        ".btn-lg": "padding: 14px 32px; font-size: 18px;",
        ".btn-md": "padding: 10px 24px; font-size: 16px;",
        ".btn-primary": "background-color: #e0e5ec; color: #6d5dfc; border: none; font-weight: 700; cursor: pointer; border-radius: 12px; box-shadow: 6px 6px 12px #b8b9be, -6px -6px 12px #ffffff;",
        ".btn-sm": "padding: 6px 16px; font-size: 14px;",
        ".card-bordered": "border: 1px solid rgba(255, 255, 255, 0.6);",
        ".card-surface": "background-color: #e0e5ec; border-radius: 16px; box-shadow: 9px 9px 16px #b8b9be, -9px -9px 16px #ffffff;",
        ".container-lg": "max-width: 1200px; margin: 0 auto;",
        ".container-md": "max-width: 800px; margin: 0 auto;",
        ".flex-between": "display: flex; justify-content: space-between; align-items: center;",
        ".flex-center": "display: flex; justify-content: center; align-items: center;",
        ".footer-container": "padding: 32px; background-color: #e0e5ec;",
        ".gap-lg": "gap: 48px;",
        ".gap-md": "gap: 24px;",
        ".gap-sm": "gap: 12px;",
        ".glow-effect": "box-shadow: inset 2px 2px 5px #b8b9be, inset -3px -3px 7px #ffffff;",
        ".grid-2-cols": "display: grid; grid-template-columns: repeat(2, 1fr);",
        ".grid-3-cols": "display: grid; grid-template-columns: repeat(3, 1fr);",
        ".heading-lg": "font-size: 32px; font-weight: 700; line-height: 1.2;",
        ".heading-md": "font-size: 24px; font-weight: 600;",
        ".heading-xl": "font-size: 48px; font-weight: 800; line-height: 1.15; margin-bottom: 16px; color: #31344b;",
        ".hero-section": "padding: 96px 24px; background: #e0e5ec;",
        ".input-field": "width: 100%; padding: 12px 18px; background-color: #e0e5ec; border: none; border-radius: 12px; color: #31344b; font-size: 15px; box-shadow: inset 3px 3px 6px #b8b9be, inset -3px -3px 6px #ffffff;",
        ".items-center": "align-items: center;",
        ".max-w-sm": "max-width: 480px;",
        ".mb-md": "margin-bottom: 24px;",
        ".mb-xl": "margin-bottom: 48px;",
        ".mx-auto": "margin-left: auto; margin-right: auto;",
        ".navbar-sticky": "position: sticky; top: 0; display: flex; justify-content: space-between; align-items: center; padding: 16px 32px; background-color: #e0e5ec; z-index: 100;",
        ".p-lg": "padding: 32px;",
        ".section-spacing": "padding: 80px 24px;",
        ".text-accent": "color: #6d5dfc;",
        ".text-center": "text-align: center;",
        ".text-lead": "font-size: 18px; line-height: 1.6;",
        ".text-muted": "color: #595b71;",
        ".text-primary": "color: #31344b;",
        ".text-sm": "font-size: 14px;",
        ".text-subtle": "color: #a3b1c6;"
    },
    "mobile": {
        ".flex-between": "flex-direction: column; gap: 16px;",
        ".grid-2-cols": "grid-template-columns: 1fr;",
        ".grid-3-cols": "grid-template-columns: 1fr;",
        ".heading-xl": "font-size: 28px;"
    },
    "tablet": {
        ".grid-3-cols": "grid-template-columns: repeat(2, 1fr);",
        ".heading-xl": "font-size: 36px;"
    }
}