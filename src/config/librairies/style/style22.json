{
    "desktop": {
        ".badge-accent": "background-color: #ffffff; color: #000000; border: 1px solid #ffffff;",
        ".badge-pill": "display: inline-block; padding: 4px 12px; border-radius: 0px; font-size: 12px; font-weight: 900; margin-bottom: 20px; text-transform: uppercase;",
        ".bg-dark-surface": "background-color: #121212;",
        ".bg-gradient-dark": "background: #000000;",
        ".bg-radial-glow": "background: #000000;",
        ".border-b-dark": "border-bottom: 2px solid #ffffff;",
        ".border-t-dark": "border-top: 2px solid #ffffff;",
        ".brand-logo": "font-weight: 900; font-size: 20px; color: #ffffff; letter-spacing: 2px;",
        ".btn-lg": "padding: 14px 28px; font-size: 18px;",
        ".btn-md": "padding: 10px 20px; font-size: 16px;",
        ".btn-primary": "background-color: #ffffff; color: #000000; border: 2px solid #ffffff; font-weight: 900; cursor: pointer; border-radius: 0px; text-transform: uppercase;",
        ".btn-sm": "padding: 6px 12px; font-size: 14px;",
        ".card-bordered": "border: 2px solid #ffffff;",
        ".card-surface": "background-color: #000000; border-radius: 0px;",
        ".container-lg": "max-width: 1200px; margin: 0 auto;",
        ".container-md": "max-width: 800px; margin: 0 auto;",
        ".flex-between": "display: flex; justify-content: space-between; align-items: center;",
        ".flex-center": "display: flex; justify-content: center; align-items: center;",
        ".footer-container": "padding: 32px; background-color: #000000;",
        ".gap-lg": "gap: 48px;",
        ".gap-md": "gap: 24px;",
        ".gap-sm": "gap: 12px;",
        ".glow-effect": "box-shadow: 0 0 0 2px #ffffff;",
        ".grid-2-cols": "display: grid; grid-template-columns: repeat(2, 1fr);",
        ".grid-3-cols": "display: grid; grid-template-columns: repeat(3, 1fr);",
        ".heading-lg": "font-size: 32px; font-weight: 800; line-height: 1.2;",
        ".heading-md": "font-size: 24px; font-weight: 700;",
        ".heading-xl": "font-size: 48px; font-weight: 900; line-height: 1.15; margin-bottom: 16px; color: #ffffff;",
        ".hero-section": "padding: 96px 24px; background: #000000;",
        ".input-field": "width: 100%; padding: 10px 16px; background-color: #000000; border: 2px solid #ffffff; border-radius: 0px; color: #ffffff; font-size: 15px;",
        ".items-center": "align-items: center;",
        ".max-w-sm": "max-width: 480px;",
        ".mb-md": "margin-bottom: 24px;",
        ".mb-xl": "margin-bottom: 48px;",
        ".mx-auto": "margin-left: auto; margin-right: auto;",
        ".navbar-sticky": "position: sticky; top: 0; display: flex; justify-content: space-between; align-items: center; padding: 16px 32px; background-color: #000000; z-index: 100;",
        ".p-lg": "padding: 32px;",
        ".section-spacing": "padding: 80px 24px;",
        ".text-accent": "color: #ffffff; text-decoration: underline;",
        ".text-center": "text-align: center;",
        ".text-lead": "font-size: 18px; line-height: 1.6;",
        ".text-muted": "color: #cccccc;",
        ".text-primary": "color: #ffffff;",
        ".text-sm": "font-size: 14px;",
        ".text-subtle": "color: #666666;"
    },
    "mobile": {
        ".flex-between": "flex-direction: column; gap: 16px;",
        ".grid-2-cols": "grid-template-columns: 1fr;",
        ".grid-3-cols": "grid-template-columns: 1fr;",
        ".heading-xl": "font-size: 28px;"
    },
    "tablet": {
        ".grid-3-cols": "grid-template-columns: repeat(2, 1fr);",
        ".heading-xl": "font-size: 36px;"
    }
}