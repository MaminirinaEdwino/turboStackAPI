{
    "desktop": {
        ".badge-accent": "background-color: rgba(255, 107, 74, 0.15); color: #ff6b4a; border: 1px solid rgba(255, 107, 74, 0.4);",
        ".badge-pill": "display: inline-block; padding: 4px 12px; border-radius: 9999px; font-size: 12px; font-weight: 700; margin-bottom: 20px;",
        ".bg-dark-surface": "background-color: #261022;",
        ".bg-gradient-dark": "background: linear-gradient(180deg, #261022 0%, #1a0c18 100%);",
        ".bg-radial-glow": "background: radial-gradient(circle at 50% 20%, #4a153b 0%, #1a0c18 70%);",
        ".border-b-dark": "border-bottom: 1px solid #33142d;",
        ".border-t-dark": "border-top: 1px solid #33142d;",
        ".brand-logo": "font-weight: 800; font-size: 20px; color: #ff6b4a;",
        ".btn-lg": "padding: 14px 28px; font-size: 18px;",
        ".btn-md": "padding: 10px 20px; font-size: 16px;",
        ".btn-primary": "background: linear-gradient(90deg, #ff6b4a 0%, #ff2a6d 100%); color: #ffffff; border: none; font-weight: 700; cursor: pointer; border-radius: 8px;",
        ".btn-sm": "padding: 6px 12px; font-size: 14px;",
        ".card-bordered": "border: 1px solid #4a153b;",
        ".card-surface": "background-color: #261022; border-radius: 12px;",
        ".container-lg": "max-width: 1200px; margin: 0 auto;",
        ".container-md": "max-width: 800px; margin: 0 auto;",
        ".flex-between": "display: flex; justify-content: space-between; align-items: center;",
        ".flex-center": "display: flex; justify-content: center; align-items: center;",
        ".footer-container": "padding: 32px; background-color: #1a0c18;",
        ".gap-lg": "gap: 48px;",
        ".gap-md": "gap: 24px;",
        ".gap-sm": "gap: 12px;",
        ".glow-effect": "box-shadow: 0 4px 20px rgba(255, 107, 74, 0.4);",
        ".grid-2-cols": "display: grid; grid-template-columns: repeat(2, 1fr);",
        ".grid-3-cols": "display: grid; grid-template-columns: repeat(3, 1fr);",
        ".heading-lg": "font-size: 32px; font-weight: 700; line-height: 1.2;",
        ".heading-md": "font-size: 24px; font-weight: 600;",
        ".heading-xl": "font-size: 48px; font-weight: 800; line-height: 1.15; margin-bottom: 16px; color: #ffffff;",
        ".hero-section": "padding: 96px 24px; background: #1a0c18;",
        ".input-field": "width: 100%; padding: 10px 16px; background-color: #1a0c18; border: 1px solid #4a153b; border-radius: 8px; color: #fff0f3; font-size: 15px;",
        ".items-center": "align-items: center;",
        ".max-w-sm": "max-width: 480px;",
        ".mb-md": "margin-bottom: 24px;",
        ".mb-xl": "margin-bottom: 48px;",
        ".mx-auto": "margin-left: auto; margin-right: auto;",
        ".navbar-sticky": "position: sticky; top: 0; display: flex; justify-content: space-between; align-items: center; padding: 16px 32px; background-color: #1a0c18; z-index: 100;",
        ".p-lg": "padding: 32px;",
        ".section-spacing": "padding: 80px 24px;",
        ".text-accent": "color: #ff6b4a;",
        ".text-center": "text-align: center;",
        ".text-lead": "font-size: 18px; line-height: 1.6;",
        ".text-muted": "color: #d1a7b9;",
        ".text-primary": "color: #fff0f3;",
        ".text-sm": "font-size: 14px;",
        ".text-subtle": "color: #663356;"
    },
    "mobile": {
        ".flex-between": "flex-direction: column; gap: 16px;",
        ".grid-2-cols": "grid-template-columns: 1fr;",
        ".grid-3-cols": "grid-template-columns: 1fr;",
        ".heading-xl": "font-size: 28px;"
    },
    "tablet": {
        ".grid-3-cols": "grid-template-columns: repeat(2, 1fr);",
        ".heading-xl": "font-size: 36px;"
    }
}