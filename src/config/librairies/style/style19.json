{
    "desktop": {
        ".badge-accent": "background-color: rgba(100, 255, 218, 0.1); color: #64ffda; border: 1px solid #64ffda;",
        ".badge-pill": "display: inline-block; padding: 4px 12px; border-radius: 4px; font-size: 12px; font-weight: 600; margin-bottom: 20px;",
        ".bg-dark-surface": "background-color: #112240;",
        ".bg-gradient-dark": "background: linear-gradient(180deg, #112240 0%, #0a192f 100%);",
        ".bg-radial-glow": "background: radial-gradient(circle at 50% 20%, #172a45 0%, #0a192f 70%);",
        ".border-b-dark": "border-bottom: 1px solid #172a45;",
        ".border-t-dark": "border-top: 1px solid #172a45;",
        ".brand-logo": "font-weight: 700; font-size: 20px; color: #64ffda;",
        ".btn-lg": "padding: 14px 28px; font-size: 18px;",
        ".btn-md": "padding: 10px 20px; font-size: 16px;",
        ".btn-primary": "background-color: transparent; color: #64ffda; border: 1px solid #64ffda; font-weight: 600; cursor: pointer; border-radius: 4px;",
        ".btn-sm": "padding: 6px 12px; font-size: 14px;",
        ".card-bordered": "border: 1px solid #233554;",
        ".card-surface": "background-color: #112240; border-radius: 4px;",
        ".container-lg": "max-width: 1200px; margin: 0 auto;",
        ".container-md": "max-width: 800px; margin: 0 auto;",
        ".flex-between": "display: flex; justify-content: space-between; align-items: center;",
        ".flex-center": "display: flex; justify-content: center; align-items: center;",
        ".footer-container": "padding: 32px; background-color: #0a192f;",
        ".gap-lg": "gap: 48px;",
        ".gap-md": "gap: 24px;",
        ".gap-sm": "gap: 12px;",
        ".glow-effect": "box-shadow: 0 0 15px rgba(100, 255, 218, 0.2);",
        ".grid-2-cols": "display: grid; grid-template-columns: repeat(2, 1fr);",
        ".grid-3-cols": "display: grid; grid-template-columns: repeat(3, 1fr);",
        ".heading-lg": "font-size: 32px; font-weight: 700; line-height: 1.2;",
        ".heading-md": "font-size: 24px; font-weight: 600;",
        ".heading-xl": "font-size: 48px; font-weight: 800; line-height: 1.15; margin-bottom: 16px; color: #e6f1ff;",
        ".hero-section": "padding: 96px 24px; background: #0a192f;",
        ".input-field": "width: 100%; padding: 10px 16px; background-color: #0a192f; border: 1px solid #233554; border-radius: 4px; color: #ccd6f6; font-size: 15px;",
        ".items-center": "align-items: center;",
        ".max-w-sm": "max-width: 480px;",
        ".mb-md": "margin-bottom: 24px;",
        ".mb-xl": "margin-bottom: 48px;",
        ".mx-auto": "margin-left: auto; margin-right: auto;",
        ".navbar-sticky": "position: sticky; top: 0; display: flex; justify-content: space-between; align-items: center; padding: 16px 32px; background-color: #0a192f; z-index: 100;",
        ".p-lg": "padding: 32px;",
        ".section-spacing": "padding: 80px 24px;",
        ".text-accent": "color: #64ffda;",
        ".text-center": "text-align: center;",
        ".text-lead": "font-size: 18px; line-height: 1.6;",
        ".text-muted": "color: #8892b0;",
        ".text-primary": "color: #ccd6f6;",
        ".text-sm": "font-size: 14px;",
        ".text-subtle": "color: #233554;"
    },
    "mobile": {
        ".flex-between": "flex-direction: column; gap: 16px;",
        ".grid-2-cols": "grid-template-columns: 1fr;",
        ".grid-3-cols": "grid-template-columns: 1fr;",
        ".heading-xl": "font-size: 28px;"
    },
    "tablet": {
        ".grid-3-cols": "grid-template-columns: repeat(2, 1fr);",
        ".heading-xl": "font-size: 36px;"
    }
}